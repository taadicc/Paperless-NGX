<Application x:Class="HCI_2025_Project_Template.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HCI_2025_Project_Template"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="Views/LoginView.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <!-- MaterialDesign osnova. ThemeService mijenja BaseTheme i
                     PrimaryColor u toku rada preko PaletteHelper-a. -->
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="Teal"
                                             SecondaryColor="Teal"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml"/>

                <!-- Nasa paleta. Mora doci PRIJE Styles.xaml jer stilovi
                     citaju boje odavde. ThemeService zamjenjuje ovaj rjecnik. -->
                <ResourceDictionary Source="Resources/Theme.Light.xaml"/>

                <!-- Tipografija, kartice, dugmad, navigacija -->
                <ResourceDictionary Source="Resources/Styles.xaml"/>

            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
