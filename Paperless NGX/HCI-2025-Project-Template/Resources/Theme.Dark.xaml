<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="ThemeMarker">dark</sys:String>

    <!-- ══ POVRSINE ══════════════════════════════════════════════════ -->
    <Color x:Key="Color.Canvas">#0D1520</Color>
    <Color x:Key="Color.Surface">#16202E</Color>
    <Color x:Key="Color.Sunken">#1E2A3A</Color>
    <Color x:Key="Color.Shell">#0A121C</Color>
    <Color x:Key="Color.ShellDeep">#060C14</Color>
    <Color x:Key="Color.ShellHover">#1B2838</Color>

    <SolidColorBrush x:Key="Bg.Canvas"     Color="{StaticResource Color.Canvas}"/>
    <SolidColorBrush x:Key="Bg.Surface"    Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="Bg.Sunken"     Color="{StaticResource Color.Sunken}"/>
    <SolidColorBrush x:Key="Bg.Shell"      Color="{StaticResource Color.Shell}"/>
    <SolidColorBrush x:Key="Bg.ShellHover" Color="{StaticResource Color.ShellHover}"/>

    <LinearGradientBrush x:Key="Bg.ShellGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource Color.Shell}"     Offset="0"/>
        <GradientStop Color="{StaticResource Color.ShellDeep}" Offset="1"/>
    </LinearGradientBrush>

    <!-- ══ TEKST ══════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="Text.Primary"    Color="#EDF2F8"/>
    <SolidColorBrush x:Key="Text.Secondary"  Color="#9DAEC4"/>
    <SolidColorBrush x:Key="Text.Tertiary"   Color="#6B7D94"/>
    <SolidColorBrush x:Key="Text.OnAccent"   Color="#06211E"/>
    <SolidColorBrush x:Key="Text.OnShell"    Color="#E3E9F2"/>
    <SolidColorBrush x:Key="Text.OnShellDim" Color="#7C8CA5"/>

    <!-- ══ AKCENAT ════════════════════════════════════════════════════ -->
    <Color x:Key="Color.Accent">#2DD4BF</Color>
    <Color x:Key="Color.AccentDeep">#14B8A6</Color>
    <Color x:Key="Color.AccentLight">#5EEAD4</Color>

    <SolidColorBrush x:Key="Accent"        Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Accent.Hover"  Color="{StaticResource Color.AccentLight}"/>
    <SolidColorBrush x:Key="Accent.Subtle" Color="#13322F"/>
    <SolidColorBrush x:Key="Accent.Border" Color="#1F5A53"/>
    <SolidColorBrush x:Key="Accent.Text"   Color="#5EEAD4"/>

    <LinearGradientBrush x:Key="Accent.Gradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource Color.AccentDeep}"  Offset="0"/>
        <GradientStop Color="{StaticResource Color.AccentLight}" Offset="1"/>
    </LinearGradientBrush>

    <!-- ══ SEMANTICKE BOJE ════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="Info"           Color="#8B9CF0"/>
    <SolidColorBrush x:Key="Info.Subtle"    Color="#1B2244"/>
    <SolidColorBrush x:Key="Warning"        Color="#FBBF24"/>
    <SolidColorBrush x:Key="Warning.Subtle" Color="#332409"/>
    <SolidColorBrush x:Key="Danger"         Color="#F87171"/>
    <SolidColorBrush x:Key="Danger.Subtle"  Color="#3A1517"/>
    <SolidColorBrush x:Key="Success"        Color="#34D399"/>
    <SolidColorBrush x:Key="Success.Subtle" Color="#0F2C23"/>

    <!-- ══ IVICE I SJENKE ═════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="Border.Subtle" Color="#253346"/>
    <SolidColorBrush x:Key="Border.Strong" Color="#33455C"/>

    <DropShadowEffect x:Key="Shadow.Card" BlurRadius="18" ShadowDepth="2"
                      Direction="270" Opacity="0.35" Color="#000000"/>
    <DropShadowEffect x:Key="Shadow.Raised" BlurRadius="28" ShadowDepth="6"
                      Direction="270" Opacity="0.5" Color="#000000"/>

</ResourceDictionary>
