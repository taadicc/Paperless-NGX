<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Marker po kojem ThemeService prepoznaje i uklanja stari rjecnik -->
    <sys:String x:Key="ThemeMarker">light</sys:String>

    <!-- ══ POVRSINE ══════════════════════════════════════════════════
         Canvas  - pozadina cijelog radnog prostora
         Surface - kartice i paneli koji "lebde" iznad podloge
         Sunken  - udubljena polja: inputi, kutije sa sadrzajem
         Shell   - navigacija: zaglavlje i bocna traka
    -->
    <Color x:Key="Color.Canvas">#F4F7FA</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.Sunken">#F1F5F9</Color>
    <Color x:Key="Color.Shell">#111C2E</Color>
    <Color x:Key="Color.ShellDeep">#0A1424</Color>
    <Color x:Key="Color.ShellHover">#1D2B42</Color>

    <SolidColorBrush x:Key="Bg.Canvas"     Color="{StaticResource Color.Canvas}"/>
    <SolidColorBrush x:Key="Bg.Surface"    Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="Bg.Sunken"     Color="{StaticResource Color.Sunken}"/>
    <SolidColorBrush x:Key="Bg.Shell"      Color="{StaticResource Color.Shell}"/>
    <SolidColorBrush x:Key="Bg.ShellHover" Color="{StaticResource Color.ShellHover}"/>

    <LinearGradientBrush x:Key="Bg.ShellGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource Color.Shell}"     Offset="0"/>
        <GradientStop Color="{StaticResource Color.ShellDeep}" Offset="1"/>
    </LinearGradientBrush>

    <!-- ══ TEKST ══════════════════════════════════════════════════════
         Primary   - naslovi i glavni sadrzaj
         Secondary - potpisi, metapodaci
         Tertiary  - natpisi rubrika, najmanji prioritet
         OnAccent  - tekst na obojenoj podlozi
         OnShell   - tekst u navigaciji
    -->
    <SolidColorBrush x:Key="Text.Primary"    Color="#0F1B2D"/>
    <SolidColorBrush x:Key="Text.Secondary"  Color="#5A6B82"/>
    <SolidColorBrush x:Key="Text.Tertiary"   Color="#93A3B8"/>
    <SolidColorBrush x:Key="Text.OnAccent"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Text.OnShell"    Color="#E3E9F2"/>
    <SolidColorBrush x:Key="Text.OnShellDim" Color="#7C8CA5"/>

    <!-- ══ AKCENAT ════════════════════════════════════════════════════ -->
    <Color x:Key="Color.Accent">#0D9488</Color>
    <Color x:Key="Color.AccentDeep">#0B7C72</Color>
    <Color x:Key="Color.AccentLight">#2DD4BF</Color>

    <SolidColorBrush x:Key="Accent"        Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Accent.Hover"  Color="{StaticResource Color.AccentDeep}"/>
    <SolidColorBrush x:Key="Accent.Subtle" Color="#E6F7F4"/>
    <SolidColorBrush x:Key="Accent.Border" Color="#9BE3D8"/>
    <SolidColorBrush x:Key="Accent.Text"   Color="#0A6B61"/>

    <LinearGradientBrush x:Key="Accent.Gradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource Color.Accent}"      Offset="0"/>
        <GradientStop Color="{StaticResource Color.AccentLight}" Offset="1"/>
    </LinearGradientBrush>

    <!-- ══ SEMANTICKE BOJE ════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="Info"           Color="#4F63D2"/>
    <SolidColorBrush x:Key="Info.Subtle"    Color="#EEF1FE"/>
    <SolidColorBrush x:Key="Warning"        Color="#D97706"/>
    <SolidColorBrush x:Key="Warning.Subtle" Color="#FEF5E7"/>
    <SolidColorBrush x:Key="Danger"         Color="#DC2626"/>
    <SolidColorBrush x:Key="Danger.Subtle"  Color="#FEECEC"/>
    <SolidColorBrush x:Key="Success"        Color="#0E9F6E"/>
    <SolidColorBrush x:Key="Success.Subtle" Color="#E7F8F1"/>

    <!-- ══ IVICE I SJENKE ═════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="Border.Subtle" Color="#E6EBF2"/>
    <SolidColorBrush x:Key="Border.Strong" Color="#CFD8E3"/>

    <DropShadowEffect x:Key="Shadow.Card" BlurRadius="18" ShadowDepth="2"
                      Direction="270" Opacity="0.07" Color="#0F1B2D"/>
    <DropShadowEffect x:Key="Shadow.Raised" BlurRadius="28" ShadowDepth="6"
                      Direction="270" Opacity="0.13" Color="#0F1B2D"/>

</ResourceDictionary>
