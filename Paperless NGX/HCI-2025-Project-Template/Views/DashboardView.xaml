<UserControl x:Class="HCI_2025_Project_Template.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <Style x:Key="StatCard" TargetType="materialDesign:Card">
            <Setter Property="UniformCornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2"/>
            <Setter Property="Background" Value="{DynamicResource Bg.Surface}"/>
        </Style>

        <Style x:Key="RecentCard" TargetType="materialDesign:Card">
            <Setter Property="UniformCornerRadius" Value="12"/>
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp1"/>
            <Setter Property="Background" Value="{DynamicResource Bg.Surface}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Bg.Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="28,24,28,20">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{DynamicResource L_WelcomeBack}" FontSize="13"
                           Foreground="{DynamicResource Text.Secondary}"/>
                <TextBlock Text="{DynamicResource L_Dashboard}" FontSize="26" FontWeight="ExtraBold"
                           Foreground="{DynamicResource Text.Primary}"/>
            </StackPanel>
            <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True"
                         Width="100" Height="4" VerticalAlignment="Center"
                         Foreground="{DynamicResource Accent}" Background="Transparent"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
        </DockPanel>

        <!-- Stat kartice -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="28,0,28,24">
            <materialDesign:Card Background="{DynamicResource Bg.Surface}" Style="{StaticResource StatCard}" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="4" HorizontalAlignment="Left" CornerRadius="4"
                            Margin="-20,-16,0,-16" Background="{DynamicResource Accent}"/>
                    <StackPanel Margin="14,0,0,0">
                        <TextBlock Text="{DynamicResource L_Inbox}" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource Accent}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Stats.InboxCount}" FontSize="30"
                                   FontWeight="ExtraBold" Foreground="{DynamicResource Text.Primary}"/>
                        <TextBlock Text="{DynamicResource L_DocsWaiting}" FontSize="11"
                                   Foreground="{DynamicResource Text.Secondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="46" Height="46" CornerRadius="13"
                            Background="{DynamicResource Accent.Subtle}" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Inbox" Foreground="{DynamicResource Accent}"
                                                 Width="22" Height="22"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Background="{DynamicResource Bg.Surface}" Style="{StaticResource StatCard}" Margin="5,0,5,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="4" HorizontalAlignment="Left" CornerRadius="4"
                            Margin="-20,-16,0,-16" Background="{DynamicResource Info}"/>
                    <StackPanel Margin="14,0,0,0">
                        <TextBlock Text="{DynamicResource L_TotalFiles}" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource Info}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Stats.TotalDocuments}" FontSize="30"
                                   FontWeight="ExtraBold" Foreground="{DynamicResource Text.Primary}"/>
                        <TextBlock Text="{DynamicResource L_DocsIndexed}" FontSize="11"
                                   Foreground="{DynamicResource Text.Secondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="46" Height="46" CornerRadius="13"
                            Background="{DynamicResource Info.Subtle}" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="FileCheck" Foreground="{DynamicResource Info}"
                                                 Width="22" Height="22"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Background="{DynamicResource Bg.Surface}" Style="{StaticResource StatCard}" Margin="10,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="4" HorizontalAlignment="Left" CornerRadius="4"
                            Margin="-20,-16,0,-16" Background="{DynamicResource Warning}"/>
                    <StackPanel Margin="14,0,0,0">
                        <TextBlock Text="{DynamicResource L_TagsUpper}" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource Warning}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Stats.TagsCount}" FontSize="30"
                                   FontWeight="ExtraBold" Foreground="{DynamicResource Text.Primary}"/>
                        <TextBlock Text="{DynamicResource L_ActiveTags}" FontSize="11"
                                   Foreground="{DynamicResource Text.Secondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="46" Height="46" CornerRadius="13"
                            Background="{DynamicResource Warning.Subtle}" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Label" Foreground="{DynamicResource Warning}"
                                                 Width="22" Height="22"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </materialDesign:Card>
        </UniformGrid>

        <!-- Najnoviji dokumenti -->
        <Grid Grid.Row="2" Margin="28,0,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{DynamicResource L_RecentDocuments}"
                       FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource Text.Primary}"
                       Margin="0,0,0,14"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding RecentDocuments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Style="{StaticResource RecentCard}"
                     Margin="0,0,0,10"
                     Cursor="Hand"
                     Background="{DynamicResource Bg.Surface}"
                     MouseLeftButtonUp="DocumentCard_Click"
                     MouseDoubleClick="DocumentCard_DoubleClick">
                                <Grid Height="80">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Thumbnail -->
                                    <Border Grid.Column="0" CornerRadius="12,0,0,12"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Border>
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#E8F8F5" Offset="0"/>
                                                        <GradientStop Color="#CCFBF1" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <materialDesign:PackIcon Kind="FileDocumentOutline"
                                                                     Width="30" Height="30"
                                                                     Foreground="{DynamicResource Accent}" Opacity="0.25"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"/>
                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                    </Border>

                                    <!-- Accent line -->
                                    <Border Grid.Column="0" Width="3"
                                            HorizontalAlignment="Right" Background="{DynamicResource Accent}"/>

                                    <!-- Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                Margin="14,0,8,0">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Text.Primary}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <materialDesign:PackIcon Kind="CalendarOutline"
                                                                     Width="12" Height="12"
                                                                     Foreground="{DynamicResource Text.Secondary}"
                                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CreatedFormatted}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource Text.Secondary}"
                                                       Margin="4,0,12,0"/>
                                            <materialDesign:PackIcon Kind="AccountOutline"
                                                                     Width="12" Height="12"
                                                                     Foreground="{DynamicResource Text.Secondary}"
                                                                     VerticalAlignment="Center"/>
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource Text.Secondary}"
                                                       Margin="4,0,0,0">
                                                <TextBlock.Text>
                                                    <Binding Path="CorrespondentName"
                                                             TargetNullValue="—" FallbackValue="—"/>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding TagNames}" Margin="0,4,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource Accent.Subtle}" BorderBrush="{DynamicResource Accent.Border}"
                                                            BorderThickness="1" CornerRadius="4"
                                                            Margin="0,0,4,0" Padding="5,1">
                                                        <TextBlock Text="{Binding}" FontSize="9"
                                                                   Foreground="{DynamicResource Accent.Text}" FontWeight="SemiBold"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Tip badge -->
                                    <Border Grid.Column="2" Background="{DynamicResource Accent.Subtle}"
                                            BorderBrush="{DynamicResource Accent.Border}" BorderThickness="1"
                                            CornerRadius="8" Padding="10,4"
                                            VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock FontSize="11" Foreground="{DynamicResource Accent.Text}"
                                                   FontWeight="SemiBold">
                                            <TextBlock.Text>
                                                <Binding Path="DocumentTypeName"
                                                         TargetNullValue="—" FallbackValue="—"/>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Border>

                                    <!-- Diskretno dugme na hover -->
                                    <Border Grid.Column="0" Grid.ColumnSpan="3"
                                            Background="Transparent"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,0,14,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Setter Property="IsHitTestVisible" Value="False"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver,
                                                        RelativeSource={RelativeSource AncestorType=materialDesign:Card}}"
                                                        Value="True">
                                                        <Setter Property="IsHitTestVisible" Value="True"/>
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                        To="1" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                        To="0" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Button Command="{Binding DataContext.OpenDetailCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Id}"
                                                Height="32" Padding="12,0"
                                                Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}"
                                                Foreground="{DynamicResource Text.OnAccent}" Cursor="Hand"
                                                ToolTip="{DynamicResource L_OpenFullView}"
                                                materialDesign:ButtonAssist.CornerRadius="8"
                                                Style="{StaticResource MaterialDesignRaisedButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="OpenInNew"
                                                                         Width="14" Height="14"
                                                                         Margin="0,0,6,0"/>
                                                <TextBlock Text="{DynamicResource L_Open}" FontSize="10"
                                                           FontWeight="Bold"/>
                                            </StackPanel>
                                        </Button>
                                    </Border>
                                </Grid>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
