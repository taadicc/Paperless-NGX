<UserControl x:Class="HCI_2025_Project_Template.Views.DocumentDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HCI_2025_Project_Template.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <Style x:Key="MetaLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="Margin" Value="0,14,0,5"/>
        </Style>

        <Style x:Key="MetaBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Sunken}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="TabBtn" TargetType="Button"
               BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Bg.Surface}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LIJEVI PANEL -->
        <Border Grid.Column="0" Background="{DynamicResource Bg.Surface}"
                BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Nazad -->
                <Border Grid.Row="0" Background="{DynamicResource Bg.Canvas}" Padding="12,10">
                    <Button Command="{Binding GoBackCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            HorizontalAlignment="Left" Height="32"
                            Foreground="{DynamicResource Text.Secondary}" Padding="8,0"
                            materialDesign:ButtonAssist.CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="26" Height="26" CornerRadius="8"
                                    Background="{DynamicResource Bg.Sunken}" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="ArrowLeft"
                                                         Width="14" Height="14"
                                                         Foreground="{DynamicResource Accent}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{DynamicResource L_Back}" FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Naslov -->
                <Border Grid.Row="1" Background="{DynamicResource Accent}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L_DocumentDetails}" FontSize="9"
                                   FontWeight="Bold" Foreground="{DynamicResource Accent.Subtle}"/>
                        <TextBlock Text="{Binding Document.Title}" FontSize="15"
                                   FontWeight="ExtraBold" Foreground="{DynamicResource Text.OnAccent}"
                                   TextWrapping="Wrap" MaxHeight="52"
                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Tabovi -->
                <Border Grid.Row="2" Background="{DynamicResource Bg.Surface}"
                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding TabDetailsCommand}"
                                Style="{StaticResource TabBtn}">
                            <TextBlock Text="{DynamicResource L_Details}" FontSize="12" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="detalji">
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Command="{Binding TabContentCommand}"
                                Style="{StaticResource TabBtn}">
                            <TextBlock Text="{DynamicResource L_OcrTab}" FontSize="12" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="sadrzaj">
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Command="{Binding TabHistoryCommand}"
                                Style="{StaticResource TabBtn}">
                            <TextBlock Text="{DynamicResource L_History}" FontSize="12" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="historija">
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- TAB: Detalji -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                              Padding="20,8,20,8">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="detalji">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L_DocumentId}" Style="{StaticResource MetaLabel}"/>
                        <Border Style="{StaticResource MetaBox}">
                            <TextBlock Text="{Binding Document.Id}" Foreground="{DynamicResource Text.Primary}"
                                       FontFamily="Consolas" FontSize="13"/>
                        </Border>

                        <TextBlock Text="{DynamicResource L_CreatedDate}" Style="{StaticResource MetaLabel}"/>
                        <Border Style="{StaticResource MetaBox}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarOutline" Width="14" Height="14"
                                                         Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Document.CreatedFormatted}"
                                           Foreground="{DynamicResource Text.Primary}" FontSize="13" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{DynamicResource L_AddedDate}" Style="{StaticResource MetaLabel}"/>
                        <Border Style="{StaticResource MetaBox}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClockOutline" Width="14" Height="14"
                                                         Foreground="{DynamicResource Info}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding AddedFormatted}"
                                           Foreground="{DynamicResource Text.Primary}" FontSize="13" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{DynamicResource L_LastModified}" Style="{StaticResource MetaLabel}"/>
                        <Border Style="{StaticResource MetaBox}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PencilOutline" Width="14" Height="14"
                                                         Foreground="{DynamicResource Warning}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ModifiedFormatted}"
                                           Foreground="{DynamicResource Text.Primary}" FontSize="13" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{DynamicResource L_Correspondent}" Style="{StaticResource MetaLabel}"/>
                        <Border Style="{StaticResource MetaBox}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountOutline" Width="14" Height="14"
                                                         Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                <TextBlock Foreground="{DynamicResource Text.Primary}" FontSize="13" Margin="8,0,0,0">
                                    <TextBlock.Text>
                                        <Binding Path="Document.CorrespondentName"
                                                 TargetNullValue="—" FallbackValue="—"/>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{DynamicResource L_DocType}" Style="{StaticResource MetaLabel}"/>
                        <Border Style="{StaticResource MetaBox}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileTree" Width="14" Height="14"
                                                         Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                <TextBlock Foreground="{DynamicResource Text.Primary}" FontSize="13" Margin="8,0,0,0">
                                    <TextBlock.Text>
                                        <Binding Path="Document.DocumentTypeName"
                                                 TargetNullValue="—" FallbackValue="—"/>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{DynamicResource L_TagsLabel}" Style="{StaticResource MetaLabel}"/>
                        <ItemsControl ItemsSource="{Binding Document.TagNames}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Accent.Subtle}" BorderBrush="{DynamicResource Accent.Border}"
                                            BorderThickness="1" CornerRadius="6"
                                            Margin="0,0,6,6" Padding="10,4">
                                        <TextBlock Text="{Binding}" FontSize="11"
                                                   Foreground="{DynamicResource Accent.Text}" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Height="20"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB: Sadrzaj -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                              Padding="20,16,20,16">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="sadrzaj">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <Border Background="{DynamicResource Bg.Canvas}" CornerRadius="10" Padding="16"
                            BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1">
                        <TextBlock Text="{Binding Document.Content}"
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource Text.Primary}" LineHeight="20"/>
                    </Border>
                </ScrollViewer>

                <!-- TAB: Historija -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                              Padding="20,8,20,8">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="historija">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" CornerRadius="10"
                                        Background="{DynamicResource Bg.Canvas}"
                                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1">
                                    <Grid Margin="14,10,14,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="6"
                                                Padding="8,3" Margin="0,0,12,0"
                                                VerticalAlignment="Top" Background="{DynamicResource Accent.Subtle}">
                                            <TextBlock Text="{Binding ActionLabel}"
                                                       FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource Accent.Text}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="AccountOutline"
                                                                         Width="13" Height="13"
                                                                         Foreground="{DynamicResource Text.Secondary}"
                                                                         VerticalAlignment="Center"/>
                                                <TextBlock FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text.Primary}" Margin="5,0,0,0">
                                                    <TextBlock.Text>
                                                        <Binding Path="Actor"
                                                                 TargetNullValue="System"
                                                                 FallbackValue="System"/>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Text="{Binding TimestampFormatted}"
                                                       FontSize="11" Foreground="{DynamicResource Text.Secondary}"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Loading -->
                <Border Grid.Row="3" Background="{DynamicResource Bg.Canvas}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4"
                                 Foreground="{DynamicResource Accent}" Background="Transparent"
                                 VerticalAlignment="Center"/>
                </Border>

                <!-- Akcije -->
                <Border Grid.Row="4" Background="{DynamicResource Bg.Canvas}"
                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0"
                        Padding="16,14">
                    <StackPanel>
                        <ProgressBar IsIndeterminate="True" Height="3"
                                     Foreground="{DynamicResource Accent}" Background="Transparent"
                                     Margin="0,0,0,10"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>

                        <Button Command="{Binding DownloadCommand}"
                                Height="40"
                                Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}"
                                Foreground="{DynamicResource Text.OnAccent}" HorizontalAlignment="Stretch"
                                materialDesign:ButtonAssist.CornerRadius="10"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Download" Width="16" Height="16"
                                                         Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource L_DownloadDocument}" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- DESNI PANEL - preview -->
        <Grid Grid.Column="1" Background="{DynamicResource Bg.Sunken}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Bg.Surface}"
                    BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1" Padding="16,10">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                                VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Eye" Foreground="{DynamicResource Accent}"
                                                 Width="16" Height="16"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource L_PreviewDocument}" Foreground="{DynamicResource Text.Secondary}"
                                   FontSize="11" FontWeight="Bold"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                                VerticalAlignment="Center">
                        <Button Command="{Binding DownloadCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="{DynamicResource Accent}" Height="32"
                                ToolTip="{DynamicResource L_SaveCopyHint}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Download" Width="16" Height="16"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource L_Save}" Margin="6,0,0,0" FontSize="11"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <views:PdfPreviewView Grid.Row="1"
                                  DocumentId="{Binding Document.Id}"
                                  DocumentTitle="{Binding Document.Title}"/>
        </Grid>
    </Grid>
</UserControl>
