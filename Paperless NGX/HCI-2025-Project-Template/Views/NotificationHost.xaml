<UserControl x:Class="HCI_2025_Project_Template.Views.NotificationHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             HorizontalAlignment="Right" VerticalAlignment="Bottom"
             Margin="0,0,24,24" MaxWidth="420" Background="Transparent">

    <ItemsControl x:Name="Items">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <materialDesign:Card UniformCornerRadius="10" Margin="0,8,0,0"
                                     materialDesign:ElevationAssist.Elevation="Dp8"
                                     Background="White">
                    <materialDesign:Card.RenderTransform>
                        <TranslateTransform X="0"/>
                    </materialDesign:Card.RenderTransform>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Bojena traka koja nosi značenje uz ikonu, ne samo bojom -->
                        <Rectangle Grid.Column="0" Fill="{Binding Accent}"/>

                        <materialDesign:PackIcon Grid.Column="1"
                                                 Kind="{Binding Icon}"
                                                 Width="22" Height="22"
                                                 Margin="14,16,10,16"
                                                 VerticalAlignment="Top"
                                                 Foreground="{Binding Accent}"/>

                        <StackPanel Grid.Column="2" Margin="0,14,10,14">
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold" FontSize="13"
                                       Foreground="#1E293B" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Message}"
                                       Visibility="{Binding MessageVisibility}"
                                       FontSize="12" Margin="0,3,0,0"
                                       Foreground="#64748B" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="3" Click="OnDismiss"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Width="30" Height="30" Margin="0,8,8,0"
                                VerticalAlignment="Top"
                                ToolTip="Zatvori obavještenje">
                            <materialDesign:PackIcon Kind="Close" Width="14" Height="14"
                                                     Foreground="#94A3B8"/>
                        </Button>
                    </Grid>
                </materialDesign:Card>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>