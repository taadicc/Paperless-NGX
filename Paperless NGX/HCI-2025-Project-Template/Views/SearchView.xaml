<UserControl x:Class="HCI_2025_Project_Template.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:HCI_2025_Project_Template.Helpers">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- Ista DocCard kao u MainWindow -->
        <Style x:Key="SearchDocCard" TargetType="materialDesign:Card">
            <Setter Property="UniformCornerRadius" Value="14"/>
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2"/>
            <Setter Property="Background" Value="{DynamicResource Bg.Surface}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp8"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                 To="1.03" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                 To="1.03" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                 To="1.0" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                 To="1.0" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Bg.Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Info traka -->
        <Border Grid.Row="0" Background="{DynamicResource Bg.Surface}"
                BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1"
                Padding="28,10,28,10"
                Visibility="{Binding HasSearched, Converter={StaticResource BoolVis}}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="TextSearchVariant"
                                             Width="16" Height="16"
                                             Foreground="{DynamicResource Accent}"
                                             VerticalAlignment="Center"/>
                    <TextBlock Margin="8,0,0,0" FontSize="13"
                               Foreground="{DynamicResource Text.Secondary}">
                        <Run Text="{DynamicResource L_Found}"/>
                        <Run Text="{Binding TotalResults, Mode=OneWay}"
                             FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>
                        <Run Text="{DynamicResource L_ResultsFor}"/>
                        <Run Text="&quot;"/>
                        <Run Text="{Binding Query, Mode=OneWay}"
                             FontWeight="Bold" FontStyle="Italic" Foreground="{DynamicResource Accent}"/>
                        <Run Text="&quot;"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Command="{Binding PrevPageCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Width="30" Height="30">
                        <materialDesign:PackIcon Kind="ChevronLeft" Foreground="{DynamicResource Accent}"/>
                    </Button>
                    <Border Background="{DynamicResource Accent.Subtle}" CornerRadius="6"
                            Padding="12,3" Margin="4,0">
                        <TextBlock Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="12">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} / {1}">
                                    <Binding Path="CurrentPage"/>
                                    <Binding Path="TotalPages"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Border>
                    <Button Command="{Binding NextPageCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Width="30" Height="30">
                        <materialDesign:PackIcon Kind="ChevronRight" Foreground="{DynamicResource Accent}"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Sadržaj -->
        <Grid Grid.Row="1" Margin="28,20,28,20">

            <!-- Loading spinner -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                <ProgressBar IsIndeterminate="True" Style="{StaticResource MaterialDesignCircularProgressBar}"
                             Width="48" Height="48" Value="0"
                             Foreground="{DynamicResource Accent}"/>
                <TextBlock Text="{DynamicResource L_Searching}" Foreground="{DynamicResource Text.Secondary}"
                           FontSize="13" HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>

            <!-- Početno stanje -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasSearched}" Value="False"/>
                                    <Condition Binding="{Binding IsBusy}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Width="90" Height="90" CornerRadius="28"
                        Background="{DynamicResource Accent.Subtle}" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="TextSearch" Width="46" Height="46"
                                             Foreground="{DynamicResource Accent}" Opacity="0.6"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{DynamicResource L_SearchDocuments}" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource Text.Primary}"
                           HorizontalAlignment="Center" Margin="0,20,0,6"/>
                <TextBlock Text="{DynamicResource L_EnterKeywords}"
                           FontSize="13" Foreground="{DynamicResource Text.Secondary}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Nema rezultata -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasSearched}" Value="True"/>
                                    <Condition Binding="{Binding HasResults}" Value="False"/>
                                    <Condition Binding="{Binding IsBusy}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Width="90" Height="90" CornerRadius="28"
                        Background="{DynamicResource Warning.Subtle}" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="FileSearchOutline" Width="46" Height="46"
                                             Foreground="{DynamicResource Warning}" Opacity="0.7"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{DynamicResource L_NoResults}" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource Text.Primary}"
                           HorizontalAlignment="Center" Margin="0,20,0,6"/>
                <TextBlock FontSize="13" Foreground="{DynamicResource Text.Secondary}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="300">
                    <TextBlock.Text>
                        <MultiBinding StringFormat='Nema dokumenata koji odgovaraju "{0}"'>
                            <Binding Path="Query"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>

            <!-- Kartice sa rezultatima — ISTI dizajn kao Documents view -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding HasResults, Converter={StaticResource BoolVis}}">
                <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <helpers:ResponsiveWrapPanel MinItemWidth="200" ItemSpacing="16"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Background="{DynamicResource Bg.Surface}" Style="{StaticResource SearchDocCard}"
                                                 Height="290" Cursor="Hand">
                                <materialDesign:Card.InputBindings>
                                    <MouseBinding Gesture="LeftClick"
                                                  Command="{Binding DataContext.SelectResultCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding Id}"/>
                                </materialDesign:Card.InputBindings>

                                <Grid>
                                    <StackPanel>
                                        <!-- Thumbnail area -->
                                        <Grid Height="130">
                                            <Border CornerRadius="14,14,0,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#E8F8F5" Offset="0"/>
                                                        <GradientStop Color="#CCFBF1" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <materialDesign:PackIcon Kind="FileDocumentOutline"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"
                                                                     Width="48" Height="48"
                                                                     Foreground="{DynamicResource Accent}" Opacity="0.18"/>
                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,8,8,0" Background="{DynamicResource Accent}"
                                                    CornerRadius="6" Padding="6,2">
                                                <TextBlock Text="{Binding DocumentTypeName}"
                                                           FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Text.OnAccent}"/>
                                            </Border>
                                            <!-- Score badge -->
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Margin="8,8,0,0" Background="{DynamicResource Bg.Shell}"
                                                    CornerRadius="6" Padding="6,2">
                                                <TextBlock Text="{Binding ScorePercent}"
                                                           FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                            </Border>
                                        </Grid>

                                        <!-- Gradient accent -->
                                        <Border Height="3">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="{DynamicResource Color.Accent}" Offset="0"/>
                                                    <GradientStop Color="{DynamicResource Color.AccentLight}" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- Card body -->
                                        <StackPanel Margin="12,10,12,8">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="Bold" FontSize="12"
                                                       MaxHeight="36"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Text.Primary}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <materialDesign:PackIcon Kind="CalendarOutline"
                                                                         Width="12" Height="12"
                                                                         Foreground="{DynamicResource Text.Secondary}"
                                                                         VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding CreatedFormatted}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource Text.Secondary}"
                                                           Margin="4,0,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <materialDesign:PackIcon Kind="AccountOutline"
                                                                         Width="12" Height="12"
                                                                         Foreground="{DynamicResource Text.Secondary}"
                                                                         VerticalAlignment="Center"/>
                                                <TextBlock FontSize="10" Margin="4,0,0,0"
                                                           Foreground="{DynamicResource Text.Secondary}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Text>
                                                        <Binding Path="CorrespondentName"
                                                                 TargetNullValue="—" FallbackValue="—"/>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding TagNames}" Margin="0,6,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource Accent.Subtle}" BorderBrush="{DynamicResource Accent.Border}"
                                                                BorderThickness="1" CornerRadius="5"
                                                                Margin="0,0,4,3" Padding="5,1">
                                                            <TextBlock Text="{Binding}" FontSize="9"
                                                                       Foreground="{DynamicResource Accent.Text}" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Hover overlay — ISTI kao u MainWindow -->
                                    <Border Background="#CC000000" CornerRadius="14">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver,
                                                        RelativeSource={RelativeSource AncestorType=materialDesign:Card}}"
                                                        Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                        To="1" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                        To="0" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                            <!-- Pregled u desnom panelu -->
                                            <Button Command="{Binding DataContext.SelectResultCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}"
                                                    Height="38" Width="160" Margin="0,0,0,10"
                                                    Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}"
                                                    Foreground="{DynamicResource Text.OnAccent}"
                                                    materialDesign:ButtonAssist.CornerRadius="10"
                                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                                    Cursor="Hand">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Eye"
                                                                             Width="15" Height="15"
                                                                             Margin="0,0,7,0"/>
                                                    <TextBlock Text="{DynamicResource L_Preview}" FontSize="11" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Button>
                                            <!-- Otvori detalje -->
                                            <Button Command="{Binding DataContext.OpenResultCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}"
                                                    Height="38" Width="160"
                                                    Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Info}"
                                                    Foreground="{DynamicResource Text.OnAccent}"
                                                    materialDesign:ButtonAssist.CornerRadius="10"
                                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                                    Cursor="Hand">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="OpenInNew"
                                                                             Width="15" Height="15"
                                                                             Margin="0,0,7,0"/>
                                                    <TextBlock Text="{DynamicResource L_Open}" FontSize="11" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>