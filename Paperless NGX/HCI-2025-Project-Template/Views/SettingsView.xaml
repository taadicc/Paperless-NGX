<UserControl x:Class="HCI_2025_Project_Template.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid Background="{DynamicResource Bg.Canvas}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel Margin="28,24,28,32" MaxWidth="720" HorizontalAlignment="Left">

                <!-- Naslov ekrana -->
                <TextBlock Text="{DynamicResource L_Application}"
                           Style="{StaticResource T.Caption}"/>
                <TextBlock Text="{DynamicResource L_Settings}"
                           Style="{StaticResource T.Display}" Margin="0,2,0,24"/>

                <!-- ══ TEMA ══════════════════════════════════════════ -->
                <Border Style="{StaticResource Card.Surface}" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="38" Height="38" CornerRadius="11"
                                    Background="{DynamicResource Accent.Subtle}">
                                <materialDesign:PackIcon Kind="{Binding ThemeIcon}"
                                                         Width="19" Height="19"
                                                         Foreground="{DynamicResource Accent}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource L_Theme}"
                                           Style="{StaticResource T.Title}"/>
                                <TextBlock Text="{DynamicResource L_ChooseAppearance}"
                                           Style="{StaticResource T.Caption}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Style="{StaticResource Box.Sunken}" Padding="16,12">
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ThemeLabel}"
                                               Style="{StaticResource T.Body}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource L_ThemeAppliesNow}"
                                               Style="{StaticResource T.Caption}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleButton DockPanel.Dock="Right"
                                              VerticalAlignment="Center"
                                              Cursor="Hand"
                                              IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ══ AKCENTNA BOJA ═════════════════════════════════ -->
                <Border Style="{StaticResource Card.Surface}" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="38" Height="38" CornerRadius="11"
                                    Background="{DynamicResource Accent.Subtle}">
                                <materialDesign:PackIcon Kind="Palette"
                                                         Width="19" Height="19"
                                                         Foreground="{DynamicResource Accent}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource L_AccentColor}"
                                           Style="{StaticResource T.Title}"/>
                                <TextBlock Text="{DynamicResource L_PrimaryUiColor}"
                                           Style="{StaticResource T.Caption}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Trenutna boja -->
                        <Border Style="{StaticResource Box.Sunken}" Padding="14,12"
                                Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="40" CornerRadius="11"
                                        Background="{Binding AccentPreview}"/>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource L_CurrentColor}"
                                               Style="{StaticResource T.Caption}"/>
                                    <TextBlock Text="{Binding AccentHex}"
                                               Style="{StaticResource T.Body}"
                                               FontFamily="Consolas" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Paleta -->
                        <ItemsControl ItemsSource="{Binding AccentOptions}" Margin="0,0,0,14">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectAccentCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Hex}"
                                            ToolTip="{Binding Name}"
                                            Cursor="Hand" Width="44" Height="44"
                                            Margin="0,0,10,10" Padding="0"
                                            BorderThickness="0" Background="Transparent"
                                            Style="{StaticResource MaterialDesignFlatButton}">
                                        <Border Width="36" Height="36" CornerRadius="10"
                                                Background="{Binding Swatch}"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBox Text="{Binding AccentHex, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource Input.Text}"
                                 FontFamily="Consolas"
                                 materialDesign:HintAssist.Hint="{DynamicResource L_HexHint}"/>
                    </StackPanel>
                </Border>

                <!-- ══ JEZIK ═════════════════════════════════════════ -->
                <Border Style="{StaticResource Card.Surface}" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="38" Height="38" CornerRadius="11"
                                    Background="{DynamicResource Accent.Subtle}">
                                <materialDesign:PackIcon Kind="Translate"
                                                         Width="19" Height="19"
                                                         Foreground="{DynamicResource Accent}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource L_Language}"
                                           Style="{StaticResource T.Title}"/>
                                <TextBlock Text="{DynamicResource L_UiLanguage}"
                                           Style="{StaticResource T.Caption}"/>
                            </StackPanel>
                        </StackPanel>

                        <UniformGrid Columns="2">
                            <RadioButton GroupName="Lang" Cursor="Hand"
                                         IsChecked="{Binding IsSerbian, Mode=TwoWay}"
                                         Style="{StaticResource MaterialDesignTabRadioButton}"
                                         Margin="0,0,6,0" Height="46"
                                         Background="{DynamicResource Bg.Sunken}"
                                         BorderBrush="{DynamicResource Border.Subtle}">
                                <TextBlock Text="{DynamicResource L_LangSerbian}"
                                           FontSize="13" FontWeight="SemiBold"/>
                            </RadioButton>
                            <RadioButton GroupName="Lang" Cursor="Hand"
                                         IsChecked="{Binding IsEnglish, Mode=TwoWay}"
                                         Style="{StaticResource MaterialDesignTabRadioButton}"
                                         Margin="6,0,0,0" Height="46"
                                         Background="{DynamicResource Bg.Sunken}"
                                         BorderBrush="{DynamicResource Border.Subtle}">
                                <TextBlock Text="{DynamicResource L_LangEnglish}"
                                           FontSize="13" FontWeight="SemiBold"/>
                            </RadioButton>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ══ PREČICE ═══════════════════════════════════════ -->
                <Border Style="{StaticResource Card.Surface}" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="38" Height="38" CornerRadius="11"
                                    Background="{DynamicResource Accent.Subtle}">
                                <materialDesign:PackIcon Kind="KeyboardOutline"
                                                         Width="19" Height="19"
                                                         Foreground="{DynamicResource Accent}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource L_Shortcuts}"
                                           Style="{StaticResource T.Title}"/>
                                <TextBlock Text="{DynamicResource L_ShortcutsHint}"
                                           Style="{StaticResource T.Caption}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Style="{StaticResource Box.Sunken}" Padding="16,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Ctrl + F" FontFamily="Consolas"
                                               FontWeight="Bold" HorizontalAlignment="Left"
                                               Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="Fokus na pretragu" HorizontalAlignment="Right"
                                               Style="{StaticResource T.Caption}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Ctrl + N" FontFamily="Consolas"
                                               FontWeight="Bold" HorizontalAlignment="Left"
                                               Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="Dodaj dokument" HorizontalAlignment="Right"
                                               Style="{StaticResource T.Caption}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Ctrl + D" FontFamily="Consolas"
                                               FontWeight="Bold" HorizontalAlignment="Left"
                                               Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="Lista dokumenata" HorizontalAlignment="Right"
                                               Style="{StaticResource T.Caption}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Ctrl + S" FontFamily="Consolas"
                                               FontWeight="Bold" HorizontalAlignment="Left"
                                               Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="Sačuvani dokumenti" HorizontalAlignment="Right"
                                               Style="{StaticResource T.Caption}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Ctrl + T" FontFamily="Consolas"
                                               FontWeight="Bold" HorizontalAlignment="Left"
                                               Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="Oznake" HorizontalAlignment="Right"
                                               Style="{StaticResource T.Caption}"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="F5" FontFamily="Consolas"
                                               FontWeight="Bold" HorizontalAlignment="Left"
                                               Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="Osvježi listu" HorizontalAlignment="Right"
                                               Style="{StaticResource T.Caption}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{DynamicResource L_VoiceHint}"
                                   Style="{StaticResource T.Caption}"
                                   Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- ══ RESET ═════════════════════════════════════════ -->
                <Border Style="{StaticResource Card.Surface}">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource L_ResetSettings}"
                                       Style="{StaticResource T.Title}"/>
                            <TextBlock Text="{DynamicResource L_ResetAllDefaults}"
                                       Style="{StaticResource T.Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                Command="{Binding ResetCommand}"
                                Style="{StaticResource Btn.Secondary}"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Restore" Width="16" Height="16"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource L_ResetToDefault}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
