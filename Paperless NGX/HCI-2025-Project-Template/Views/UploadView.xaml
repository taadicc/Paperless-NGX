<UserControl x:Class="HCI_2025_Project_Template.Views.UploadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:HCI_2025_Project_Template.Helpers"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <helpers:HexToBrushConverter x:Key="HexBrush"/>
        <helpers:HexToContrastBrushConverter x:Key="HexContrast"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Bg.Canvas}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <!-- ══ LIJEVA KOLONA — Drop zona + info ══ -->
        <Grid Grid.Column="0" Margin="28,28,14,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Naslov -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="{DynamicResource L_AddingDocument}" FontSize="13"
                           Foreground="{DynamicResource Text.Secondary}"/>
                <TextBlock Text="{DynamicResource L_Upload}" FontSize="26" FontWeight="ExtraBold"
                           Foreground="{DynamicResource Text.Primary}"/>
            </StackPanel>

            <!-- Drop zona / file picker -->
            <Border Grid.Row="1" CornerRadius="20"
                    BorderThickness="2" Margin="0,0,0,16"
                    Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                        <Setter Property="Background" Value="{DynamicResource Bg.Surface}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFile}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Accent.Subtle}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <!-- Placeholder — nema fajla -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="40">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFile}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Border Width="100" Height="100" CornerRadius="30"
                                Background="{DynamicResource Accent.Subtle}" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="CloudUploadOutline"
                                                     Width="52" Height="52"
                                                     Foreground="{DynamicResource Accent}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource L_DropFileHere}" FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Text.Primary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,8"/>
                        <TextBlock Text="{DynamicResource L_OrClickToChoose}"
                                   FontSize="13"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>
                        <TextBlock Text="{DynamicResource L_SupportedFormats}"
                                   FontSize="11" Foreground="{DynamicResource Text.Tertiary}"
                                   HorizontalAlignment="Center"/>

                        <Button Command="{Binding BrowseFileCommand}"
                                Height="44" Padding="28,0" Margin="0,24,0,0"
                                Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}"
                                Foreground="{DynamicResource Text.OnAccent}" HorizontalAlignment="Center"
                                materialDesign:ButtonAssist.CornerRadius="12"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderOpen"
                                                         Width="16" Height="16"
                                                         Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource L_ChooseFile}" FontWeight="Bold"
                                           FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Fajl odabran -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="40">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFile}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Border Width="100" Height="100" CornerRadius="30"
                                Background="{DynamicResource Accent.Subtle}" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="FileCheckOutline"
                                                     Width="52" Height="52"
                                                     Foreground="{DynamicResource Accent}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding FileName}" FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Text.Primary}"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="320" Margin="0,20,0,6"/>
                        <TextBlock Text="{DynamicResource L_FileReady}"
                                   FontSize="12" Foreground="{DynamicResource Accent}"
                                   HorizontalAlignment="Center"/>

                        <Button Command="{Binding BrowseFileCommand}"
                                Height="38" Padding="20,0" Margin="0,20,0,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="{DynamicResource Text.Secondary}" BorderBrush="{DynamicResource Accent.Border}"
                                HorizontalAlignment="Center">
                            <TextBlock Text="{DynamicResource L_ChangeFile}" FontSize="12"/>
                        </Button>
                    </StackPanel>

                    <!-- Invisible click layer -->
                    <Button Command="{Binding BrowseFileCommand}"
                            Opacity="0" Cursor="Hand"/>
                </Grid>

                <!-- Drag & drop support -->
                <Border.AllowDrop>True</Border.AllowDrop>
            </Border>

            <!-- Status poruke -->
            <StackPanel Grid.Row="2">
                <!-- Greška validacije -->
                <Border Background="{DynamicResource Danger.Subtle}" CornerRadius="10" Padding="14,10"
                        BorderBrush="{DynamicResource Danger.Subtle}" BorderThickness="1"
                        Margin="0,0,0,8"
                        Visibility="{Binding ValidationError,
                            Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertCircleOutline"
                                                 Width="16" Height="16"
                                                 Foreground="{DynamicResource Danger}"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ValidationError}" FontSize="12"
                                   Foreground="{DynamicResource Danger}" Margin="8,0,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Uspješan upload -->
                <Border Background="{DynamicResource Accent.Subtle}" CornerRadius="10" Padding="14,10"
                        BorderBrush="{DynamicResource Accent.Border}" BorderThickness="1"
                        Visibility="{Binding IsSuccess, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckCircleOutline"
                                                 Width="16" Height="16"
                                                 Foreground="{DynamicResource Accent}"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                                   Foreground="{DynamicResource Accent}" Margin="8,0,0,0"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ══ DESNA KOLONA — Forma sa metapodacima ══ -->
        <Border Grid.Column="1" Background="{DynamicResource Bg.Surface}"
                BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="{DynamicResource Bg.Surface}"
                        BorderBrush="{DynamicResource Border.Subtle}"
                        BorderThickness="0,0,0,1" Padding="24,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="12"
                                Background="{DynamicResource Accent.Subtle}">
                            <materialDesign:PackIcon Kind="FormatListBulletedType"
                                                     Width="20" Height="20"
                                                     Foreground="{DynamicResource Accent}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource L_FillInfo}"
                                       Style="{StaticResource T.Title}"/>
                            <TextBlock Text="{DynamicResource L_DocMetadata}"
                                       Style="{StaticResource T.Caption}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Forma -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,20,28,24">

                        <!-- Naslov -->
                        <TextBlock Text="{DynamicResource L_TitleRequired}" Style="{StaticResource FieldLabel}" Margin="0,20,0,8"/>
                        <TextBox Text="{Binding Title,
                                     UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="{DynamicResource L_DocNameHint}"
                                 FontSize="14"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Height="48" VerticalContentAlignment="Center"/>

                        <!-- Datum kreiranja -->
                        <TextBlock Text="{DynamicResource L_CreatedDate}" Style="{StaticResource FieldLabel}" Margin="0,20,0,8"/>
                        <DatePicker SelectedDate="{Binding Created}"
                                    FontSize="13"
                                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                    Height="48" VerticalContentAlignment="Center"
                                    materialDesign:HintAssist.Hint="{DynamicResource L_PickDate}"/>

                        <!-- Tip dokumenta -->
                        <TextBlock Text="{DynamicResource L_DocType}" Style="{StaticResource FieldLabel}" Margin="0,20,0,8"/>
                        <ComboBox ItemsSource="{Binding DocumentTypes}"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedDocumentTypeId}"
                                  DisplayMemberPath="Name"
                                  FontSize="13"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Height="48" VerticalContentAlignment="Center"
                                  materialDesign:HintAssist.Hint="{DynamicResource L_PickType}"/>

                        <!-- Korespodent -->
                        <TextBlock Text="{DynamicResource L_Correspondent}" Style="{StaticResource FieldLabel}" Margin="0,20,0,8"/>
                        <ComboBox ItemsSource="{Binding Correspondents}"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedCorrespondentId}"
                                  DisplayMemberPath="Name"
                                  FontSize="13"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Height="48" VerticalContentAlignment="Center"
                                  materialDesign:HintAssist.Hint="{DynamicResource L_PickCorrespondent}"/>

                        <!-- Tagovi -->
                        <TextBlock Text="{DynamicResource L_TagsLabel}" Style="{StaticResource FieldLabel}" Margin="0,20,0,8"/>
                        <Border Background="{DynamicResource Bg.Canvas}" CornerRadius="10"
                                BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                                Padding="12" MaxHeight="180">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SelectableTags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Style="{x:Null}"
                                                          Background="Transparent"
                                                          BorderThickness="0" Padding="0"
                                                          MinWidth="0" MinHeight="0"
                                                          Cursor="Hand" Margin="0,0,7,7"
                                                          ToolTip="{Binding Name}"
                                                          HorizontalAlignment="Left">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="Chip" CornerRadius="14"
                                                                Padding="12,7" BorderThickness="1.5"
                                                                Background="{DynamicResource Bg.Surface}"
                                                                BorderBrush="{Binding DisplayColor,
                                                                    Converter={StaticResource HexBrush}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border x:Name="Dot" Width="9" Height="9"
                                                                        CornerRadius="5" Margin="0,0,7,0"
                                                                        VerticalAlignment="Center"
                                                                        Background="{Binding DisplayColor,
                                                                            Converter={StaticResource HexBrush}}"/>
                                                                <materialDesign:PackIcon x:Name="Ico"
                                                                    Kind="Check" Width="13" Height="13"
                                                                    Margin="0,0,6,0" VerticalAlignment="Center"
                                                                    Visibility="Collapsed"
                                                                    Foreground="{DynamicResource Text.OnAccent}"/>
                                                                <TextBlock x:Name="Txt"
                                                                    Text="{Binding Name}"
                                                                    FontSize="12" FontWeight="SemiBold"
                                                                    VerticalAlignment="Center"
                                                                    TextTrimming="None"
                                                                    Foreground="{DynamicResource Text.Primary}"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Chip" Property="BorderBrush"
                                                                        Value="{DynamicResource Accent.Border}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="Chip" Property="Background"
                                                                        Value="{Binding DisplayColor,
                                                                            Converter={StaticResource HexBrush}}"/>
                                                                <Setter TargetName="Chip" Property="BorderBrush"
                                                                        Value="{Binding DisplayColor,
                                                                            Converter={StaticResource HexBrush}}"/>
                                                                <Setter TargetName="Dot" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="Ico" Property="Visibility" Value="Visible"/>
                                                                <Setter TargetName="Ico" Property="Foreground"
                                                                        Value="{Binding DisplayColor,
                                                                            Converter={StaticResource HexContrast}}"/>
                                                                <Setter TargetName="Txt" Property="Foreground"
                                                                        Value="{Binding DisplayColor,
                                                                            Converter={StaticResource HexContrast}}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer sa dugmadima -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource Border.Subtle}"
                        BorderThickness="0,1,0,0" Padding="24,16">
                    <StackPanel>

                        <!-- Loading bar -->
                        <ProgressBar IsIndeterminate="True" Height="4"
                                     Foreground="{DynamicResource Accent}" Background="Transparent"
                                     Margin="0,0,0,12"
                                     Visibility="{Binding IsBusy,
                                         Converter={StaticResource BoolVis}}"/>

                        <!-- Upload dugme -->
                        <Button Command="{Binding UploadCommand}"
                                Height="46" Margin="0,0,0,8"
                                Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}"
                                Foreground="{DynamicResource Text.OnAccent}" HorizontalAlignment="Stretch"
                                materialDesign:ButtonAssist.CornerRadius="12"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CloudUpload"
                                                         Width="18" Height="18"
                                                         Margin="0,0,10,0"/>
                                <TextBlock Text="{DynamicResource L_UploadDocument}"
                                           FontWeight="Bold" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <!-- Nazad -->
                        <Button Command="{Binding GoBackCommand}"
                                Height="38"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="{DynamicResource Text.Secondary}" BorderBrush="{DynamicResource Border.Subtle}"
                                HorizontalAlignment="Stretch">
                            <TextBlock Text="{DynamicResource L_Cancel}" FontSize="12"/>
                        </Button>

                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
